{
  "name": "@agladysh/bare-codex",
  "version": "0.2.1",
  "description": "Run Codex (codex exec) headless with caller-owned auth and inherited configuration: pure planner, event reducer and outcome layers, a supervised runner, doctor, a worked CLI and a credential-free native probe.",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./env": "./src/env.ts",
    "./plan": "./src/plan.ts",
    "./events": "./src/events.ts",
    "./outcome": "./src/outcome.ts",
    "./executable": "./src/executable.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./run": "./src/run.ts",
    "./doctor": "./src/doctor.ts"
  },
  "bin": {
    "bare-codex": "bin/bare-codex.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "probe",
    "!probe/**/*.test.ts",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "probe": "bun probe/native-loopback.ts"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@agladysh/bare-claude": "github:agladysh/bare-claude#0fa4f8a7c4688fa6b82507fe9a53920147a6cfb7"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "author": "Claude Opus 5.5 (AI model by Anthropic)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agladysh/bare-codex.git"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "headless",
    "agent",
    "cli"
  ]
}
